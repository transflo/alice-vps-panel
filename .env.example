# 面板登录密码（必填，至少 8 位；留空或用示例里的占位密码都会拒绝启动）
PANEL_PASSWORD=

# Alice API 凭据：在 Alice 控制台 → Account → API Keys 创建
ALICE_CLIENT_ID=
ALICE_SECRET=

# 以下为可选项
# 登录有效期（小时）
SESSION_HOURS=24
# 面板前面的反向代理层数（docker-compose.yml 默认只监听 127.0.0.1:10086，配合反向代理使用）：
# 一层（Nginx / Caddy）设为 1，多层（如 Cloudflare + Nginx）设成层数，用于识别真实 IP 和 HTTPS。
# 直接对外监听、没有反向代理时必须设为 0，否则请求头可被伪造。
TRUST_PROXY=1
# 只有当直连面板的对端地址是「受信代理」时，面板才采信 X-Forwarded-For（登录限流按它计数）。
# 默认受信：回环、私有网段、链路本地地址 —— 覆盖宿主机上的 Nginx/Caddy 和 Docker 网络里的反代。
# 如果你的反代是用公网地址直连面板的，在这里填它的 IP（逗号分隔）。
# 设置后只信任这里列出的地址，不再使用上面的默认值。
# TRUSTED_PROXY_IPS=
# Alice API 地址，一般无需修改
# ALICE_API_BASE=https://app.alice.ws/cli/v1
# 构建镜像时下载前端依赖用的 npm 源，国内服务器可改成 https://registry.npmmirror.com
# NPM_REGISTRY=https://registry.npmjs.org

# 自动续期（默认开启：没有专门设置过的实例视为开启、每次 7 小时；可在网页或 Telegram bot 里按实例关闭或改时长）：到期前多少分钟开始尝试，默认 60（即到期前 1 小时）
# AUTO_RENEW_BEFORE_MINUTES=60
# 自动续期失败后，两次尝试之间间隔多少分钟，默认 10；每个到期点最多尝试 3 次
# AUTO_RENEW_RETRY_MINUTES=10
# Alice 返回的创建时间的钟面所在时区，默认 +08:00（实测 creation_at 的偏移标签有误，详见 README）
# ALICE_CLOCK_OFFSET=+08:00
# Telegram 消息里显示时间用的时区（IANA 名称），默认 Asia/Shanghai
# DISPLAY_TIME_ZONE=Asia/Shanghai

# Telegram bot（可选）：向 @BotFather 创建 bot 取得 token；ID 是你自己的数字用户 ID（用 @userinfobot 之类查询），多个用逗号分隔。
# 两项都填了才会启动 bot，且只响应白名单里的用户的私聊。
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=
# Telegram API 地址，一般无需修改
# TELEGRAM_API_BASE=https://api.telegram.org
